{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "swarmscribe-website",
  "main": "../../site-worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "swarmscribe.iamfatness.us",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  }
}
